": 51, "texto": "CURA NO VAZIO", "cor": "#ff4b3a"}, {"tipo": "fala", "at": 888, "dur": 80, "cor": "Preto", "texto": "Obrigado, Dourado. Pode me curar."}, {"tipo": "legenda", "at": 969, "dur": 146, "texto": "Aí a horda chega. A barricada cai, e o Preto levanta outra. E outra."}, {"tipo": "selo", "at": 1118, "dur": 60, "texto": "O PRETO: 7 BARRICADAS", "cor": "#e8701a"}, {"tipo": "legenda", "at": 1178, "dur": 26, "texto": "E o Dourado?"}, {"tipo": "fala", "at": 1207, "dur": 123, "cor": "Dourado", "texto": "Vou abastecer o motor enquanto esperamos o amanhecer."}, {"tipo": "acao", "at": 1326, "dur": 1, "n": 2}, {"tipo": "selo", "at": 1326, "dur": 51, "texto": "AÇÃO NÚMERO 2", "cor": "#7a3cff"}, {"tipo": "legenda", "at": 1377, "dur": 56, "texto": "Último tique antes do sol."}, {"tipo": "fala", "at": 1436, "dur": 131, "cor": "Coral", "texto": "Preto e Dourado estão no Lançamento! Quebrem a barricada!"}, {"tipo": "selo", "at": 1579, "dur": 60, "texto": "O PRETO FOI MORDIDO", "cor": "#3dbb3d"}, {"tipo": "fala", "at": 1597, "dur": 138, "cor": "Preto", "texto": "Fica aqui comigo até amanhecer, Dourado. Não vamos sair dessa sala."}, {"tipo": "legenda", "at": 1736, "dur": 156, "texto": "Amanheceu. Um sobrevivente: o Dourado. Com duas ações em sessenta tiques."}, {"tipo": "numero", "at": 1895, "dur": 90, "texto": "2 AÇÕES · 1 SOBREVIVENTE", "sub": "o Preto vira zumbi depois do fim"}, {"tipo": "legenda", "at": 1913, "dur": 176, "texto": "A IA mais fraca foi a última de pé. Quem merecia sobreviver: o Preto ou o Dourado?"}], "audio": [{"src": "sfx/heartbeat.mp3", "at": 0, "vol": 0.6}, {"src": "sfx/pop.mp3", "at": 0, "vol": 0.5}, {"src": "sfx/pop.mp3", "at": 172, "vol": 0.5}, {"src": "zumbi/voz/45756615a79aaf43.mp3", "at": 357}, {"src": "sfx/pop.mp3", "at": 554, "vol": 0.5}, {"src": "zumbi/voz/afd096c0c6518673.mp3", "at": 708}, {"src": "sfx/coin.mp3", "at": 819, "vol": 0.55}, {"src": "sfx/wrong-buzzer.mp3", "at": 819, "vol": 0.45}, {"src": "sfx/pop.mp3", "at": 888, "vol": 0.5}, {"sr