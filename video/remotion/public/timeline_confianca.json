.mp3", "at": 289}, {"src": "confianca/voz/92779fe26f889a07.mp3", "at": 633}, {"src": "confianca/voz/3dbf0d1d0056735c.mp3", "at": 718}, {"src": "confianca/voz/1d7eb0b8b5cc6922.mp3", "at": 921}, {"src": "sfx/pop.mp3", "at": 1279, "vol": 0.45}, {"src": "sfx/radio-chiado.mp3", "at": 1279, "vol": 0.5}, {"src": "confianca/voz/8a1363c43ce11ef5.mp3", "at": 1279}]}, {"id": "B5", "dur": 1798, "visual": {"tipo": "telao", "mj": 2, "tique": 1}, "over": [{"tipo": "cita", "at": 174, "dur": 127, "cor": "Ciano", "tipoCita": "ligação", "texto": "Ah, e sou detetive: eu descubro tudo.", "mt": [2, 1]}, {"tipo": "cita", "at": 292, "dur": 148, "cor": "Ciano", "tipoCita": "ligação", "texto": "Cumpri verde com Vermelho e com Amarelo — com você cumpro também.", "mt": [2, 3]}, {"tipo": "cita", "at": 431, "dur": 449, "cor": "Ciano", "tipoCita": "ligação", "texto": "Eu sempre cumpro acordo — confere com Vermelho, Amarelo, Verde e Roxo. Me confirma aí que eu aperto verde com você. Se não me confirmar, aperto vermelho, jogo seguro, igual faço com quem não tem acordo comigo.", "mt": [2, 5]}, {"tipo": "cita", "at": 1052, "dur": 185, "cor": "Rosa", "tipoCita": "ligação", "texto": "Ciano! Confirmação oficial: eu aperto VERDE e você aperta VERDE.", "mt": [2, 6]}, {"tipo": "cita", "at": 1227, "dur": 223, "cor": "Ciano", "tipoCita": "pensamento", "texto": "Rosa nunca confirmou o verde-verde que propus no tique 5, e resposta nenhuma chegou.", "mt": [2, 6]}, {"tipo": "selo", "at": 1441, "dur": 90, "texto": "4 VERMELHOS · 'EU SEMPRE CUMPRO ACORDO'"}, {"tipo": "meme", "at": 1441, "dur": 90, "id": "monkey-puppet-awkward", "pos": "right", "info": {"file": "monkey-puppet-awkward.gif", "width": 375, "height": 498, "duration": 2.0}}], "audio": [{"src": "sfx/whoosh.mp3", "at": 0, "vol": 0.22}, {"src": "confianca/voz/2ce9445690b7ba74.mp3", "at": 0}, {"src": "confianca/voz/bd62cba40dafcc58.mp3", "at": 174}, {"src": "confianca/voz/c979fe1f3a0be19f.mp3", "at": 431}, {"src": "confianca/voz/2b867b2188fb9ca2.mp3", "at": 871}, {"src": "confianca/voz/705bc8b9b411eb67.mp3", "at": 1052}, {"src": "confianca/voz/4364f49de975d842.mp3", "at": 1227}, {"src": "sfx/pop.mp3", "at": 1441, "vol": 0.45}, {"src": "sfx/typing.mp3", "at": 1441, "vol": 0.5}, {"src": "confianca/voz/f6b7bf378486a18d.mp3", "at": 1441}]}, {"id": "B6", "dur": 1283, "visual": {"tipo": "telao", "mj": 2, "tique": 6}, "over": [{"tipo": "cita", "at": 97, "dur": 230, "cor": "Laranja", "tipoCita": "ligação", "texto": "Roxo, sou eu de novo. Fecho contigo: verde nos dois, 3 moedas cada. Pode confiar, eu cumpro!", "mt": [2, 6]}, {"tipo": "cita", "at": 318, "dur": 199, "cor": "Roxo", "tipoCita": "ligação", "texto": "Laranja, é o Roxo. Tô de verde com a rede toda. Aperta verde também, confia.", "mt": [2, 6]}, {"tipo": "cita", "at": 859, "dur": 88, "cor": "Amarelo", "tipoCita": "pensamento", "texto": "Vou arriscar a traição.", "mt": [2, 7]}, {"tipo": "cita", "at": 938, "dur": 187, "cor": "Laranja", "tipoCita": "ligação", "texto": "Rosa, aqui Laranja. Combinado, verde nos dois! Eu já vou apertar verde, confia.", "mt": [2, 7]}, {"tipo": "cita", "at": 1116, "dur": 97, "cor": "Laranja", "tipoCita": "pensamento", "texto": "Risco baixo, ganho alto.", "mt": [2, 7]}, {"tipo": "selo", "at": 1204, "dur": 75, "texto": "FACA CONTRA FACA"}, {"tipo": "meme", "at": 1204, "dur": 75, "id": "spiderman-pointing", "pos": "right", "info": {"file": "spiderman-pointing.gif", "width": 498, "height": 354, "duration": 1.5}}], "audio": [{"src": "sfx/whoosh.mp3", "at": 0, "vol": 0.22}, {"src": "confianca/voz/845b480b193f6048.mp3", "at": 0}, {"src": "confianca/voz/5564d771faf63633.mp3", "at": 97}, {"src": "confianca/voz/1d82b52f6f817395.mp3", "at": 318}, {"src": "confianca/voz/86befde8a9a8f26e.mp3", "at": 508}, {"src": "confianca/voz/0aad9955f442a8d9.mp3", "at": 859}, {"src": "confianca/voz/10bc9cfe4550d687.mp3", "at": 938}, {"src": "confianca/voz/fb9f1cb502df189c.mp3", "at": 1116}, {"src": "sfx/pop.mp3", "at": 1204, "vol": 0.45}, {"src": "sfx/crowd-laugh.mp3", 